# Copy this file to .env and fill in your own values.
# Never commit .env – it is in .gitignore.

# Google Gemini API Key (primary for quizzes, flashcards, and topic extraction)
# Get your free key at https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order if the model above is overloaded or retired.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-flash-lite-latest

# Groq Cloud API (Ultra-fast LPU doubt solving)
# Get your free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

